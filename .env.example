# ==========================================================================
# videosearcher — variáveis de ambiente
# Copie para .env  ->  cp .env.example .env
# Você NÃO precisa preencher tudo. Uma chave gratuita já faz o sistema rodar.
# O README explica onde cadastrar cada uma (seção "Cadastro das LLMs").
# ==========================================================================

# --------------------------------------------------------------------------
# LLM — camada de briefing visual
# Ordem de fallback definida em channels/_base.yaml (chave `llm.chain`).
# Preencha ao menos UMA. Recomendado começar por MISTRAL_API_KEY (tier grátis
# generoso) e ZAI_API_KEY (modelos Flash gratuitos, inclusive visão).
# --------------------------------------------------------------------------

# Mistral — https://console.mistral.ai  (tier Experiment gratuito)
MISTRAL_API_KEY=

# Z.ai / GLM — https://z.ai  (GLM-4.7-Flash e GLM-4.5-Flash gratuitos)
ZAI_API_KEY=

# Groq — https://console.groq.com  (free tier sem cartão de crédito)
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai  (roteador: 400+ modelos numa chave)
OPENROUTER_API_KEY=

# NVIDIA NIM — https://build.nvidia.com  (100+ modelos, sem cartão)
NVIDIA_API_KEY=

# Cerebras — https://cloud.cerebras.ai  (free tier, inferência rapidíssima)
CEREBRAS_API_KEY=

# OpenAI — https://platform.openai.com  (pago)
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com  (pago)
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------------
# Identificação opcional no OpenRouter (aparece nos rankings públicos deles)
# --------------------------------------------------------------------------
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=videosearcher

# --------------------------------------------------------------------------
# Provedores de mídia (usados a partir da fase 3)
# --------------------------------------------------------------------------

# Pexels — https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay — https://pixabay.com/service/about/api/
PIXABAY_API_KEY=

# Coverr — https://coverr.co/developers
COVERR_API_KEY=
