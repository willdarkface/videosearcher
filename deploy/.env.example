# ==========================================================================
# Configuração do stack. Copie e ajuste:   cp .env.example .env
# O docker compose lê este arquivo automaticamente.
# ==========================================================================

# --------------------------------------------------------------------------
# Postgres
# TROQUE A SENHA antes de expor a porta para fora da máquina.
# --------------------------------------------------------------------------
POSTGRES_DB=videosearcher
POSTGRES_USER=vs
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT_HOST=5432

# --------------------------------------------------------------------------
# NATS (fila de processamento assíncrono)
# --------------------------------------------------------------------------
NATS_PORT_HOST=4222
NATS_MONITOR_PORT=8222

# --------------------------------------------------------------------------
# Portas dos serviços
# --------------------------------------------------------------------------
BFF_PORT=8080
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:8080

# --------------------------------------------------------------------------
# Escala dos workers. Corte de vídeo é CPU-bound: subir réplicas de `media`
# é o caminho quando a fila de ingestão crescer.
#   docker compose up -d --scale media=4
# --------------------------------------------------------------------------
MEDIA_REPLICAS=1
CLASSIFY_REPLICAS=1

# Duração dos pedaços gerados na ingestão de acervo (4, 6 ou 8 segundos)
DURACAO_CORTE_S=6

# --------------------------------------------------------------------------
# LLM — briefing visual. Uma chave já faz funcionar.
# Ver a seção "Cadastro das LLMs" do README.
# --------------------------------------------------------------------------
MISTRAL_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=

# --------------------------------------------------------------------------
# Classificação de acervo
# GLM-4.6V-Flash é gratuito na Z.ai e usa a ZAI_API_KEY acima.
# --------------------------------------------------------------------------
MODELO_VLM=glm-4.6v-flash
MODELO_EMBEDDING=siglip-base-patch16-224

# --------------------------------------------------------------------------
# Provedores de mídia
# --------------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
